{
    "custom/power": {
        "format": "{0}",
        "rotate": 0,
        "tooltip": true,
        "tooltip-format": " Logout menu",
        "on-click": "moonwalk-shell logoutlaunch 1",
        "menu": "on-click-right",
        "menu-file": "${MOONWALK_WAYBAR_MENU_DIR:-$XDG_DATA_HOME/waybar/menus}/power.xml",
        "menu-actions": {
            "lock": "moonwalk-shell lockscreen.sh",
            "logout": "hyprctl dispatch 'hl.dsp.exit()'",
            "shutdown-now": "shutdown now",
            "shutdown-wait": "systemctl poweroff",
            "reboot-now": "systemctl reboot",
            "reboot-firmware": "systemctl reboot --firmware-setup",
            "suspend": "systemctl suspend",
            "hibernate": "systemctl hibernate"
        },
        "interval": 86400
    }
}