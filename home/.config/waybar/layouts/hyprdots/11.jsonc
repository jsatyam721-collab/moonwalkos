{
  "layer": "top",
  "output": ["*"],
  "position": "top",
  "height": 26,
  "margin-top": 5,
  "margin-left": 6,
  "margin-right": 6,
  "spacing": 0,
  "exclusive": true,
  "passthrough": false,
  "reload_style_on_change": true,
  "include": [
    "$XDG_CONFIG_HOME/waybar/modules/*json*",
    "$XDG_CONFIG_HOME/waybar/includes/includes.json"
  ],

  "modules-left": ["hyprland/workspaces#label", "group/media", "tray"],
  "modules-center": ["group/status", "custom/weather", "hyprland/workspaces#nums", "clock", "clock#date"],
  "modules-right": ["group/utils", "group/hw", "battery", "pulseaudio#mic", "group/focus", "custom/power"],

  "hyprland/workspaces#label": {
    "active-only": true,
    "all-outputs": false,
    "format": "Workspace {id}",
    "disable-scroll": true,
    "on-click": "",
    "persistent-workspaces": {}
  },

  "hyprland/workspaces#nums": {
    "format": "{id}",
    "all-outputs": true,
    "active-only": false,
    "persistent-workspaces": {"*": 5},
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e-1\"})'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e+1\"})'"
  },

  "group/media": {"orientation": "horizontal", "modules": ["image#cover", "mpris"]},
  "image#cover": {
    "exec": "$HOME/.local/bin/waybar-cover",
    "size": 19,
    "interval": 2,
    "on-click": "playerctl play-pause"
  },
  "mpris": {
    "format": "{title}  <span size='7.5pt' alpha='65%'>{artist}</span>",
    "format-paused": "<span alpha='70%'>{title}</span>  <span size='7.5pt' alpha='50%'>paused</span>",
    "justify": "center",
    "title-len": 18,
    "artist-len": 22,
    "interval": 1,
    "tooltip-format": "{title}\n{artist}\n{position} / {length}",
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-click-middle": "playerctl previous"
  },

  "tray": {"icon-size": 13, "spacing": 6},

  "group/status": {"orientation": "horizontal", "modules": ["pulseaudio"]},
  "network#eth": {
    "interface": "enp*",
    "format-ethernet": "󰈀",
    "format-linked": "",
    "format-disconnected": "",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
    "interval": 5,
    "on-click": "$HOME/.local/bin/phone"
  },
  "network": {
    "interface": "wl*",
    "format-wifi": "{icon}",
    "format-ethernet": "",
    "format-linked": "󰤫",
    "format-disconnected": "󰤮",
    "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
    "tooltip-format-wifi": "{essid}  {signalStrength}%\n{ipaddr}",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 5,
    "on-click": "$HOME/.local/bin/phone"
  },
  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-connected": "󰂱",
    "tooltip-format": "{controller_alias}",
    "tooltip-format-connected": "{controller_alias}\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "$HOME/.local/bin/phone"
  },
  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "󰝟",
    "format-icons": {"default": ["󰕿", "󰖀", "󰕾"], "headphone": "󰋋", "headset": "󰋎"},
    "tooltip-format": "{desc}  {volume}%",
    "scroll-step": 5,
    "on-click": "moonwalk-shell volumecontrol -o m",
    "on-click-right": "pavucontrol -t 3",
    "on-scroll-up": "moonwalk-shell volumecontrol -o i",
    "on-scroll-down": "moonwalk-shell volumecontrol -o d"
  },

  "custom/weather": {
    "exec": "$HOME/.local/bin/waybar-weather",
    "return-type": "json",
    "format": "{}",
    "interval": 1800,
    "signal": 10,
    "tooltip": true,
    "on-click": "pkill -RTMIN+10 -x waybar"
  },

  "clock": {
    "format": "{:%I:%M %p}",
    "tooltip-format": "<span>{calendar}</span>",
    "calendar": {"mode": "month", "on-scroll": 1}
  },
  "clock#date": {
    "format": "<span font_family='JetBrainsMono Nerd Font Propo' weight='bold'>󰃭</span>  {:%a, %b %d}",
    "tooltip": false
  },

  "group/utils": {"orientation": "horizontal", "drawer": {"transition-duration": 450, "transition-left-to-right": false, "children-class": "util-child"}, "modules": ["custom/shot", "custom/picker", "custom/night", "idle_inhibitor", "custom/clip"]},
  "custom/shot": {"format": "󰆞", "tooltip-format": "Screenshot area", "on-click": "moonwalk-shell screenshot s", "interval": "once"},
  "custom/picker": {"format": "󰈊", "tooltip-format": "Color picker", "on-click": "hyprpicker -an", "interval": "once"},
  "custom/night": {
    "exec": "$HOME/.local/bin/waybar-nightlight",
    "return-type": "json",
    "format": "{}",
    "interval": "once",
    "signal": 19,
    "on-click": "moonwalk-shell hyprsunset -t -P waybar:19",
    "on-scroll-up": "moonwalk-shell hyprsunset -i '' -P waybar:19",
    "on-scroll-down": "moonwalk-shell hyprsunset -d '' -P waybar:19"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {"activated": "󰅶", "deactivated": "󰛊"},
    "tooltip-format-activated": "Caffeine on",
    "tooltip-format-deactivated": "Caffeine off"
  },
  "custom/clip": {"format": "󰅌", "tooltip-format": "Clipboard history", "on-click": "sleep 0.1 && moonwalk-shell cliphist -c", "interval": "once"},

  "group/hw": {"orientation": "horizontal", "modules": ["custom/cpu", "custom/gpu"]},
  "custom/cpu": {"exec": "$HOME/.local/bin/waybar-cpu", "return-type": "json", "format": "{}", "restart-interval": 5},
  "custom/gpu": {"exec": "$HOME/.local/bin/waybar-gpu", "return-type": "json", "format": "{}", "restart-interval": 5},

  "battery": {
    "states": {"warning": 20, "critical": 10},
    "format": "<span font_family='JetBrainsMono Nerd Font Propo' weight='bold'>{icon}</span>  {capacity}%",
    "format-charging": "<span font_family='JetBrainsMono Nerd Font Propo' weight='bold'>\uf0e7</span>  {capacity}%",
    "format-plugged": "<span font_family='JetBrainsMono Nerd Font Propo' weight='bold'>\uf1e6</span>  {capacity}%",
    "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
    "tooltip-format": "{timeTo}"
  },

  "pulseaudio#mic": {
    "format": "{format_source}",
    "format-source": "󰍬",
    "format-source-muted": "󰍭",
    "tooltip-format": "{source_desc}  {source_volume}%",
    "on-click": "moonwalk-shell volumecontrol -i m",
    "on-scroll-up": "moonwalk-shell volumecontrol -i i",
    "on-scroll-down": "moonwalk-shell volumecontrol -i d"
  },

  "group/focus": {"orientation": "horizontal", "modules": ["wlr/taskbar", "hyprland/window"]},
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 15,
    "all-outputs": true,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "ignore-list": []
  },
  "hyprland/window": {
    "format": "{title}",
    "max-length": 18,
    "separate-outputs": false,
    "rewrite": {}
  },

  "custom/power": {
    "format": "󰐥",
    "tooltip-format": "Power menu",
    "on-click": "moonwalk-shell logoutlaunch 1",
    "interval": "once"
  }
}
