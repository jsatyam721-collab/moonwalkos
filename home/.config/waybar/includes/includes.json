        "@HOME@/.local/share/waybar/modules/image#profile.jsonc",
        "@HOME@/.local/share/waybar/modules/idle_inhibitor.jsonc",
        "@HOME@/.local/share/waybar/modules/custom-sensorsinfo.jsonc",
        "@HOME@/.local/share/waybar/modules/custom-keybindhint.jsonc",
        "@HOME@/.local/share/waybar/modules/group-mediaplayer.jsonc",
        "@HOME@/.local/share/waybar/modules/group-volumecontrol.jsonc",
        "@HOME@/.local/share/waybar/modules/custom-gpuinfo#intel.jsonc",
        "@HOME@/.local/share/waybar/modules/custom-wbar.jsonc",
        "@HOME@/.local/share/waybar/modules/network.jsonc",
        "@HOME@/.local/share/waybar/modules/hyprland-workspaces#kanji.jsonc",
        "@HOME@/.local/share/waybar/modules/tray.jsonc",
        "@HOME@/.local/share/waybar/modules/bluetooth.jsonc",
        "@HOME@/.local/share/waybar/modules/privacy.jsonc",
        "@HOME@/.local/share/waybar/modules/custom-clipboard.jsonc",
        "@HOME@/.local/share/waybar/modules/custom-weather.jsonc",
        "@HOME@/.local/share/waybar/modules/custom-app-launcher.jsonc",
        "@HOME@/.local/share/waybar/modules/clock.jsonc",
        "@HOME@/.local/share/waybar/modules/custom-swaync.jsonc",
        "@HOME@/.local/share/waybar/modules/custom-gpuinfo.jsonc",
        "@HOME@/.local/share/waybar/modules/memory.jsonc",
        "@HOME@/.local/share/waybar/modules/group-user-menu.jsonc",
        "@HOME@/.local/share/waybar/modules/custom-spotify.jsonc",
        "@HOME@/.local/share/waybar/modules/mpris.jsonc",
        "@HOME@/.local/share/waybar/modules/custom-hyprsunset.jsonc",
        "@HOME@/.local/share/waybar/modules/custom-cliphist.jsonc",
        "@HOME@/.local/share/waybar/modules/custom-dunst.jsonc",
        "@HOME@/.local/share/waybar/modules/cpu.jsonc",
        "@HOME@/.local/share/waybar/modules/custom-moonwalk-menu.jsonc",
        "@HOME@/.local/share/waybar/modules/cava.jsonc",
        "@HOME@/.local/share/waybar/modules/group-hide-tray.jsonc",
        "@HOME@/.local/share/waybar/modules/hyprland-workspaces.jsonc",
        "@HOME@/.local/share/waybar/modules/group-eyecare.jsonc",
        "@HOME@/.local/share/waybar/modules/custom-workflows.jsonc",
        "@HOME@/.local/share/waybar/modules/custom-cava.jsonc",
        "@HOME@/.local/share/waybar/modules/temperature.jsonc",
        "@HOME@/.local/share/waybar/modules/mpd.jsonc",
        "@HOME@/.local/share/waybar/modules/custom-gpuinfo#amd.jsonc",
        "@HOME@/.local/share/waybar/modules/gamemode.jsonc",
        "@HOME@/.local/share/waybar/modules/custom-gpuinfo#nvidia.jsonc",
        "@HOME@/.local/share/waybar/modules/custom-github_moonwalk.jsonc",
        "@HOME@/.local/share/waybar/modules/pulseaudio.jsonc",
        "@HOME@/.local/share/waybar/modules/custom-mediaplayer.jsonc",
        "@HOME@/.local/share/waybar/modules/custom-updates.jsonc",
        "@HOME@/.local/share/waybar/modules/wlr-taskbar.jsonc",
        "@HOME@/.local/share/waybar/modules/backlight.jsonc",
        "@HOME@/.local/share/waybar/modules/custom-gamemode.jsonc"
    ],
    "image#wallpaper": {
        "size": 30,
        "icon-size-multiplier": 3
    },
    "tray": {
        "icon-size": 16,
        "icon-size-multiplier": 1.6
    },
    "wlr/taskbar#windows": {
        "icon-size": 16,
        "icon-size-multiplier": 1.6
    },
    "privacy": {
        "icon-size": 10,
        "icon-size-multiplier": 1
    },
    "wlr/taskbar": {
        "icon-size": 16,
        "icon-size-multiplier": 1.6
    },
    "position": "top",
    "user": {
        "format": "",
        "interval": 60,
        "height": 20,
        "width": 20,
        "icon": true
    },
    "custom/wallchange": {
        "format": "\udb80\udd8a {0}",
        "rotate": 0,
        "tooltip-format": "\udb80\udd8a Switch wallpaper",
        "on-click": "moonwalk-shell wallpaper -n",
        "on-click-right": "moonwalk-shell wallpaper -p",
        "on-click-middle": "pkill -f '^qs -p .*/wallwheel' || qs -p $HOME/.config/wallwheel",
        "interval": 86400,
        "tooltip": true
    },
    "custom/theme": {
        "format": "\ue22b{0}",
        "rotate": 0,
        "tooltip-format": "\udb81\udfe1 Switch theme",
        "on-click": "moonwalk-shell app -t scope -- theme.switch.sh -n",
        "on-click-right": "moonwalk-shell app -t scope -- theme.switch.sh -p",
        "on-click-middle": "pkill -f '^qs -p .*/wallwheel' || qs -p $HOME/.config/wallwheel",
        "interval": 86400,
        "tooltip": true
    },
    "custom/moonwalk-menu": {
        "format": "\ueb94 ",
        "tooltip": true,
        "tooltip-format": "Right-click for more MoonwalkOS options",
        "menu": "on-click-right",
        "menu-file": "${MOONWALK_WAYBAR_MENU_DIR:-$XDG_DATA_HOME/waybar/menus}/moonwalk-menu.xml",
        "menu-actions": {
            "animations-select": "moonwalk-shell animations --select",
            "wallpaper-select": "pkill -f '^qs -p .*/wallwheel' || qs -p $HOME/.config/wallwheel",
            "wallpaper-next": "moonwalk-shell app -t scope -- wallpaper.sh --next --global",
            "wallpaper-previous": "moonwalk-shell app -t scope -- wallpaper.sh --previous --global",
            "wallpaper-random": "moonwalk-shell app -t scope -- wallpaper.sh --random --global",
            "theme-next": "moonwalk-shell app -t scope -- theme.switch.sh -n",
            "theme-previous": "moonwalk-shell app -t scope -- theme.switch.sh -p",
            "theme-select": "pkill -f '^qs -p .*/wallwheel' || qs -p $HOME/.config/wallwheel",
            "theme-import": "moonwalk-shell app -T -- moonwalkctl theme import",
            "layouts-select": "moonwalk-shell layouts --select;pkill -RTMIN+19 waybar",
            "waybar-restart": "moonwalk-shell waybar -ubg",
            "waybar-reload-css": "sed -i '${/^$/d;}'  $XDG_CONFIG_HOME/waybar/style.css",
            "waybar-layout-select": "moonwalk-shell waybar --select-layout",
            "waybar-style-select": "moonwalk-shell waybar --select-style",
            "waybar-layout-next": "moonwalk-shell waybar --update --next",
            "waybar-layout-previous": "moonwalk-shell waybar --update --prev",
            "lockscreen-select": "moonwalk-shell lockscreen --select",
            "workflows-select": "moonwalk-shell workflows --select;pkill -RTMIN+19 waybar",
            "hyprsunset-toggle": "moonwalk-shell hyprsunset -t -P waybar:19",
            "temp-off": "moonwalk-shell hyprsunset --cm temp -s identity -P waybar:19 ",
            "warm-candle": "moonwalk-shell hyprsunset --cm temp -s 3000 -P waybar:19",
            "soft-warm": "moonwalk-shell hyprsunset --cm temp -s 4000 -P waybar:19",
            "neutral-white": "moonwalk-shell hyprsunset --cm temp -s 5000 -P waybar:19",
            "daylight": "moonwalk-shell hyprsunset --cm temp -s 6500 -P waybar:19",
            "cool-white": "moonwalk-shell hyprsunset --cm temp -s 7500 -P waybar:19",
            "bright-blue": "moonwalk-shell hyprsunset --cm temp -s 9000 -P waybar:19",
            "arctic-blue": "moonwalk-shell hyprsunset --cm temp -s 10000 -P waybar:19",
            "gamma-100": "moonwalk-shell hyprsunset --cm gamma -s 100 -P waybar:19",
            "gamma-90": "moonwalk-shell hyprsunset --cm gamma -s 90 -P waybar:19",
            "gamma-80": "moonwalk-shell hyprsunset --cm gamma -s 80 -P waybar:19",
            "gamma-70": "moonwalk-shell hyprsunset --cm gamma -s 70 -P waybar:19",
            "gamma-60": "moonwalk-shell hyprsunset --cm gamma -s 60 -P waybar:19",
            "gamma-50": "moonwalk-shell hyprsunset --cm gamma -s 50 -P waybar:19",
            "gamma-40": "moonwalk-shell hyprsunset --cm gamma -s 40 -P waybar:19",
            "gamma-30": "moonwalk-shell hyprsunset --cm gamma -s 30 -P waybar:19",
            "gamma-20": "moonwalk-shell hyprsunset --cm gamma -s 20 -P waybar:19",
            "shaders-select": "moonwalk-shell shaders --select;pkill -RTMIN+19 waybar",
            "keybinds-hint": "moonwalk-shell keybinds_hint",
            "about-moonwalk": "xdg-open https://hydeproject.pages.dev"
        }
    }
}